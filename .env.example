# Configuração da IA. Copie este arquivo para .env e preencha.
# O .env NUNCA vai para o GitHub (está no .gitignore). Este .env.example vai, e não tem chave.
#
# No PowerShell, dentro da pasta do projeto:
#   Copy-Item .env.example .env
#   notepad .env
# e cole a sua chave depois de GEMINI_API_KEY=  (pegue em https://aistudio.google.com/apikey)

# Provedor da IA (por enquanto só "gemini").
IA_PROVEDOR=gemini

# Modelo. Modelos com plano gratuito (nov/2026): gemini-3.5-flash-lite, gemini-3.6-flash,
# gemini-3.8-flash, gemini-4-hydrogen.
IA_MODELO=gemini-3.5-flash-lite

# Chave do Google AI Studio (deixe vazio aqui no .env.example).
GEMINI_API_KEY=
